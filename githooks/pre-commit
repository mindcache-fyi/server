#!/bin/sh
# Pre-commit lint gate, installed via `make hooks`
# (git config core.hooksPath githooks). Mirrors the CI lint job so issues
# surface locally instead of on a red check.

staged_go=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$')
[ -z "$staged_go" ] && exit 0

echo "pre-commit: go vet"
go vet ./... || exit 1

echo "pre-commit: golangci-lint"
if command -v golangci-lint >/dev/null 2>&1; then
	golangci-lint run ./...
else
	# Same fallback as `make lint`: run a pinned version through go run.
	go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...
fi
